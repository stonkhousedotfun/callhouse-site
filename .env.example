# ---------------------------------------------------------------------------------------------
# @callhouse/site — every variable this package reads. All of them are optional.
#
# These are NEXT_PUBLIC_*, which means they are INLINED AT BUILD TIME, not read at runtime.
# Setting them on the Railway service as runtime variables does nothing: the strings are already
# baked into the compiled output. The Dockerfile must take them as build ARGs and promote them to
# ENV before `next build`, and changing any one means a rebuild, not a restart.
#
# Three groups. The domain URLs have production defaults compiled into lib/site.ts, so a local
# build, a CI build and the real production build all work with no .env file at all. The
# operator group has NO defaults: unset means the legal pages render an honest gap ("not yet
# designated") and /.well-known/security.txt returns 404. That is the intended state until the
# decisions in stonkhousedotfun/callhouse: ops/launch-legal.md are made. Do not fill one in with a
# placeholder to make the notice go away — the notice is the point.
#
# The optional public API below serves read-only v2 cards and stats. The server validates values
# and shows a labelled example when it is absent or unavailable. There is no RPC or API key.
# ---------------------------------------------------------------------------------------------

# ---- domains ----

# This site. Used for canonical URLs and Open Graph metadata.
# Production default: https://stonkhouse.fun
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Set to 1 only for a separate dev preview build. It adds a visible banner, noindex meta,
# robots.txt disallow-all and no sitemap. Production default is 0.
NEXT_PUBLIC_DEV_PREVIEW=0

# Keep 0 until the separate dev contracts, indexer and app are ready. To show dev cards,
# set this to 1 together with NEXT_PUBLIC_DEV_PREVIEW=1, the exact dev site/app URLs,
# and a dev NEXT_PUBLIC_API_URL. It cannot enable cards on the production host.
NEXT_PUBLIC_DEV_CARDS=0

# The dapp. Every call to action on this site is an absolute link into it, built by appUrl().
# Production default: https://app.stonkhouse.fun
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The docs (GitBook). Linked from the nav and footer.
# Production default: https://docs.stonkhouse.fun
NEXT_PUBLIC_DOCS_URL=https://docs.stonkhouse.fun

# Social links in the top bar. Keep the production defaults unless the public destinations change.
# Production defaults: https://x.com/stonkhousefun and https://github.com/stonkhousedotfun/callhouse
NEXT_PUBLIC_X_URL=https://x.com/stonkhousefun
NEXT_PUBLIC_GITHUB_URL=https://github.com/stonkhousedotfun/callhouse

# ---- optional read-only v2 API for server-rendered live cards; leave unset for example mode ----
# NEXT_PUBLIC_API_URL=http://localhost:42070

# ---- operator (read by lib/legal.ts; rendered on /terms, /privacy, /legal#reporting and
#      /.well-known/security.txt). No defaults. Blank renders "not yet designated", not a name.
#      Each one is a counsel decision — see stonkhousedotfun/callhouse: ops/launch-legal.md for what has to
#      be decided before it can be set, and for the order of operations (set, REBUILD site, verify).
#      The Dockerfile declares each as an ARG/ENV pair with no default, so a Railway build sees
#      them. ----

# Legal name of the operating entity, exactly as it should appear on the page.
NEXT_PUBLIC_OPERATOR_LEGAL_NAME=
# Where that entity is organised. Display only, shown after the name in brackets.
NEXT_PUBLIC_OPERATOR_JURISDICTION=
# Governing law of the Terms of Use, as counsel words it. Rendered verbatim on /terms.
NEXT_PUBLIC_GOVERNING_LAW=
# Where notices about the terms go.
NEXT_PUBLIC_LEGAL_CONTACT_EMAIL=
# Where data-protection requests go. May equal the legal contact.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
# Where vulnerability reports go. Also the Contact: line of security.txt; while blank that route
# is a 404 on purpose (RFC 9116 makes Contact mandatory).
NEXT_PUBLIC_SECURITY_CONTACT_EMAIL=
