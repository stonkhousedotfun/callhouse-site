{
  "name": "@callhouse/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.10.0",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start",
    "test": "node --experimental-strip-types --test",
    "test:site": "node --experimental-strip-types --test lib/site.test.ts",
    "test:live": "node --experimental-strip-types --test lib/live.test.mts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "check-twins": "node scripts/check-twins.mjs",
    "gen:markets": "node scripts/gen-markets.mjs",
    "test:market-projection": "node --test scripts/market-projection.test.mjs",
    "test:gen-markets": "node --test scripts/gen-markets.test.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  },
  "dependencies": {
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3"
  }
}
